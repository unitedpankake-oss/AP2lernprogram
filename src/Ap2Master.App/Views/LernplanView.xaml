<UserControl x:Class="Ap2Master.App.Views.LernplanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ap2Master.App.Views"
             xmlns:loc="clr-namespace:Ap2Master.App.Localization"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Left" Command="{Binding MoveSelectedLeftCommand}" />
        <KeyBinding Key="Right" Command="{Binding MoveSelectedRightCommand}" />
    </UserControl.InputBindings>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Margin="0,0,0,12" Text="{loc:Loc Plan.Title}" />
        <Border DockPanel.Dock="Top" Style="{StaticResource CardFlush}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Plan.ExamDate}" /><DatePicker SelectedDate="{Binding ExamDate}" />
                    <TextBlock Text="{loc:Loc Plan.Minutes}" /><TextBox Text="{Binding Minutes}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Text="{loc:Loc Plan.Weekdays}" /><TextBox Text="{Binding Weekdays}" />
                    <TextBlock Text="{loc:Loc Plan.Target}" /><TextBox Text="{Binding Target}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0">
                    <TextBlock Text="{loc:Loc Plan.Level}" /><TextBox Text="{Binding Level}" />
                    <TextBlock Text="{loc:Loc Plan.Difficult}" /><TextBox Text="{Binding Difficult}" />
                    <CheckBox IsChecked="{Binding IsFiae}" Content="{loc:Loc Plan.Fiae}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="{loc:Loc Plan.Create}" Command="{Binding CreateCommand}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding Status}" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{loc:Loc Plan.PrevWeek}" Command="{Binding PrevWeekCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{loc:Loc Plan.NextWeek}" Command="{Binding NextWeekCommand}" />
            <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding WeekLabel}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{loc:Loc Plan.MoveHint}" />

        <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardFlush}" Margin="4,0" Padding="8"
                            AllowDrop="True"
                            Background="{Binding IsToday, Converter={x:Static views:TodayBrushConverter.Instance}}"
                            Drop="DayDrop" DragOver="DayDragOver">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static loc:LocKeyConverter.Instance}">
                                            <Binding Path="DayKey" />
                                            <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding DateLabel}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Blocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" CornerRadius="8" Padding="8"
                                                Background="{Binding SoftHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                                BorderBrush="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                                BorderThickness="{Binding IsSelected, Converter={x:Static views:SelectedBorderConverter.Instance}}"
                                                Cursor="Hand"
                                                PreviewMouseLeftButtonDown="BlockDown"
                                                MouseMove="BlockMove">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                          Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" FontSize="12">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                                                <Binding Path="Title" />
                                                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Muted}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static loc:LocFormatConverter.Instance}" ConverterParameter="Plan.Mins">
                                                                <Binding Path="Minutes" />
                                                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
