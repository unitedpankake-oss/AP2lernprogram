<UserControl x:Class="Ap2Master.App.Views.UmlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Ap2Master.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Margin="0,0,0,12" Text="{loc:Loc Uml.Title}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardFlush}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Uml.ClassA}" /><TextBox Text="{Binding ClassA}" />
                        <TextBlock Text="{loc:Loc Uml.ClassB}" /><TextBox Text="{Binding ClassB}" />
                        <TextBlock Text="{loc:Loc Uml.Rel}" /><TextBox Text="{Binding Rel}" />
                        <TextBlock Text="{loc:Loc Uml.MultA}" /><TextBox Text="{Binding MultiA}" />
                        <TextBlock Text="{loc:Loc Uml.MultB}" /><TextBox Text="{Binding MultiB}" />
                        <Button HorizontalAlignment="Left" Content="{loc:Loc Uml.Update}" Command="{Binding UpdateCommand}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardFlush}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBox Text="{Binding Preview}" FontFamily="Cascadia Mono, Consolas" Height="220" IsReadOnly="True" AcceptsReturn="True" />
                        <TextBlock Margin="0,12,0,0" Text="{Binding Feedback}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
