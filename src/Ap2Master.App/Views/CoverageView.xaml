<UserControl x:Class="Ap2Master.App.Views.CoverageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Ap2Master.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Margin="0,0,0,12" Text="{loc:Loc Cov.Title}" />
            <Border Style="{StaticResource CardFlush}" Padding="16">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Paths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Content="{loc:Loc Cov.Calc}" Command="{Binding EvaluateCommand}" />
                    <TextBlock Text="{Binding Report}" Margin="0,12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
