<UserControl x:Class="Ap2Master.App.Views.KatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ap2Master.App.Views"
             xmlns:loc="clr-namespace:Ap2Master.App.Localization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="{loc:Loc Cat.Title}" Margin="0,0,0,12" />
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Parts}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}"
                                Command="{Binding DataContext.SelectPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Border CornerRadius="16" Padding="12,8"
                                    Background="{Binding SoftHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                    BorderBrush="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                    BorderThickness="{Binding IsSelected, Converter={x:Static views:SelectedBorderConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Title}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                               Text="{Binding TopicCount}" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleBoards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                <DockPanel Margin="0,0,0,10">
                                    <Border Width="6" CornerRadius="3" Margin="0,0,10,0"
                                            Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                    <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" Text="{Binding Title}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Clusters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardFlush}" Margin="0,0,0,12" Padding="14">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Border Width="4" Height="18" CornerRadius="2" Margin="0,0,10,0"
                                                                Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                                        <TextBlock Style="{StaticResource H3}" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                                                    <Binding Path="Title" />
                                                                    <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Cards}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource DeckButton}"
                                                                        Command="{Binding DataContext.SelectTopicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Border Width="196" MinHeight="104" CornerRadius="12" Padding="14,12,12,12"
                                                                            Background="{Binding SoftHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                                                            BorderBrush="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                                                            BorderThickness="{Binding IsSelected, Converter={x:Static views:SelectedBorderConverter.Instance}}">
                                                                        <Grid>
                                                                            <Border Width="5" HorizontalAlignment="Left" Margin="-14,-12,0,-12"
                                                                                    CornerRadius="12,0,0,12"
                                                                                    Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                                                            <StackPanel>
                                                                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                                                                    <TextBlock.Text>
                                                                                        <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                                                                            <Binding Path="Title" />
                                                                                            <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                                                        </MultiBinding>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                                                           Visibility="{Binding EstimatedMinutes, Converter={x:Static views:PositiveToVisConverter.Instance}}">
                                                                                    <TextBlock.Text>
                                                                                        <MultiBinding Converter="{x:Static loc:LocFormatConverter.Instance}" ConverterParameter="Cat.Mins">
                                                                                            <Binding Path="EstimatedMinutes" />
                                                                                            <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                                                        </MultiBinding>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource CardFlush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="6" CornerRadius="12,12,0,0"
                        Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Margin="4,12,4,8">
                    <TextBlock.Text>
                        <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                            <Binding Path="TheoryTitle" />
                            <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <ScrollViewer>
                    <TextBlock Margin="4,0,4,4" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                <Binding Path="Theory" />
                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
