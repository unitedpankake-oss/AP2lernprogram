<UserControl x:Class="Ap2Master.App.Views.AufgabenView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Ap2Master.App.Localization" xmlns:views="clr-namespace:Ap2Master.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Margin="0,0,0,12" Text="{loc:Loc Ex.Title}" />
            <Border Style="{StaticResource CardFlush}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Margin="0,0,0,8" Text="{loc:Loc Ex.Title}" />
                    <ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="Id" SelectedItem="{Binding Selected}" />
                    <TextBlock Text="{loc:Loc Ex.Seed}" /><TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Seed}" />
                    <Button HorizontalAlignment="Left" Content="{loc:Loc Ex.Generate}" Command="{Binding GenerateCommand}" />
                    <TextBlock Margin="0,16,0,8" FontSize="16" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                <Binding Path="Exercise.TaskText" />
                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBox Text="{Binding Answer}" AcceptsReturn="True" Height="80" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Ex.Check}" Command="{Binding CheckCommand}" />
                        <CheckBox Content="{loc:Loc Ex.Hint}" IsChecked="{Binding ShowHint}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Visibility="{Binding ShowHint, Converter={x:Static views:BoolVisConverter.Instance}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                <Binding Path="Exercise.Explanation" />
                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Feedback}" Margin="0,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
