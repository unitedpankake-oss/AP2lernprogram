<UserControl x:Class="Ap2Master.App.Views.SqlLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:Ap2Master.App.Views"
             xmlns:loc="clr-namespace:Ap2Master.App.Localization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="320" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardFlush}" Margin="0,0,0,0" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource H3}" Margin="0,0,0,8" Text="{loc:Loc Sql.Schema}" />
                <TreeView ItemsSource="{Binding SchemaRoot}" BorderThickness="0">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="28" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}" Text="{Binding Kind}" />
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="8,0,0,0" Text="{Binding Meta}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="6" />
                <RowDefinition Height="220" MinHeight="120" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,12,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static loc:LocFormatConverter.Instance}" ConverterParameter="Sql.Ms">
                                <Binding Path="ElapsedMs" />
                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Content="{loc:Loc Sql.Run}" Command="{Binding RunCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Sql.Cancel}" Command="{Binding CancelRunCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Sql.Reset}" Command="{Binding ResetCommand}" />
                    <CheckBox Content="{loc:Loc Sql.Preview}" IsChecked="{Binding PreviewMutations}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0"
                                                Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                FontWeight="{Binding IsActive, Converter={x:Static views:ActiveWeightConverter.Instance}}"
                                                Content="{Binding Title}" />
                                        <Button Style="{StaticResource IconButton}" Padding="6,4" Margin="0"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Content="×" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Sql.NewQuery}" Command="{Binding NewQueryCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            <avalon:TextEditor Grid.Row="1"
                               views:AvalonEditBinder.Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                               SyntaxHighlighting="SQL" ShowLineNumbers="True" WordWrap="False"
                               FontFamily="Cascadia Mono, Consolas" FontSize="14"
                               Background="{DynamicResource SurfaceAltBrush}"
                               Foreground="{DynamicResource TextBrush}" />
            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <TabControl Grid.Row="3" Margin="0,8,0,0">
                <TabItem Header="{loc:Loc Sql.Results}">
                    <Grid>
                        <DataGrid ItemsSource="{Binding ResultView}" AutoGenerateColumns="True"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  Visibility="{Binding ResultError, Converter={x:Static views:EmptyToVisConverter.Instance}}" />
                        <TextBox Text="{Binding ResultError}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                                 Visibility="{Binding ResultError, Converter={x:Static views:NotEmptyToVisConverter.Instance}}" />
                    </Grid>
                </TabItem>
                <TabItem Header="{loc:Loc Sql.Plan}">
                    <TextBox Text="{Binding PlanText}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                </TabItem>
                <TabItem Header="{loc:Loc Sql.CompareTab}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="{loc:Loc Sql.Compare}" Command="{Binding CompareSetsCommand}" />
                        <TextBox Text="{Binding Compare}" IsReadOnly="True" TextWrapping="Wrap" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
        <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Border Grid.Column="4" Style="{StaticResource CardFlush}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Margin="0,0,0,8" Text="{loc:Loc Sql.Task}" />
                    <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedPick}" />
                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,4" Text="{Binding SelectedTask.Title}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedTask.Description}" />
                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{loc:Loc Sql.Req}" />
                    <ItemsControl ItemsSource="{Binding SelectedTask.Requirements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Sql.Starter}" Command="{Binding LoadStarterCommand}" />
                        <Button Content="{loc:Loc Sql.Check}" Command="{Binding CheckSolutionCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Metric}" FontSize="22" Margin="0,12,0,4" Text="{Binding ScoreText}" />
                    <TextBlock FontWeight="SemiBold" Text="{loc:Loc Sql.Criteria}" />
                    <ItemsControl ItemsSource="{Binding Criteria}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6">
                                    <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets"
                                               Text="{Binding Passed, Converter={x:Static views:PassedGlyphConverter.Instance}}"
                                               Foreground="{Binding Passed, Converter={x:Static views:PassedBrushConverter.Instance}}" />
                                    <TextBlock>
                                        <Run Text="{Binding Label}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding Awarded}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding Points}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{loc:Loc Sql.Hints}" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="{loc:Loc Sql.Hint}" Command="{Binding RevealHintCommand}" />
                    <ItemsControl ItemsSource="{Binding VisibleHints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}" Text="{Binding Status}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{loc:Loc Sql.Readonly}"
                               Visibility="{Binding PreviewMutations, Converter={x:Static views:BoolVisConverter.Instance}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
