<UserControl x:Class="Ap2Master.App.Views.InhalteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Ap2Master.App.Localization">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Margin="0,0,0,12" Text="{loc:Loc Cont.Title}" />
        <Border Style="{StaticResource CardFlush}">
            <TextBox Text="{Binding Report}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
        </Border>
    </DockPanel>
</UserControl>
