<UserControl x:Class="Ap2Master.App.Views.LernkartenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ap2Master.App.Views"
             xmlns:loc="clr-namespace:Ap2Master.App.Localization"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="D1" Command="{Binding RateCommand}" CommandParameter="NochEinmal" />
        <KeyBinding Key="D2" Command="{Binding RateCommand}" CommandParameter="Schwer" />
        <KeyBinding Key="D3" Command="{Binding RateCommand}" CommandParameter="Gut" />
        <KeyBinding Key="D4" Command="{Binding RateCommand}" CommandParameter="Einfach" />
        <KeyBinding Key="Escape" Command="{Binding CloseSessionCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="{loc:Loc Nav.Cards}" Margin="0,0,0,8" />
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Parts}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}"
                                Command="{Binding DataContext.SelectPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Border CornerRadius="16" Padding="12,8"
                                    Background="{Binding SoftHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                    BorderBrush="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                    BorderThickness="{Binding IsSelected, Converter={x:Static views:SelectedBorderConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Title}" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8"
                                            Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                            Visibility="{Binding DueCount, Converter={x:Static views:PositiveToVisConverter.Instance}}">
                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Text="{Binding DueCount}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{loc:Loc Cards.Due}" Command="{Binding LoadDueCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Cards.Random}" Command="{Binding LoadRandomCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Cards.Weak}" Command="{Binding LoadWeakCommand}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleBoards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0"
                                            Content="{loc:Loc Cards.StudyPart}"
                                            Command="{Binding DataContext.StudyPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Border Width="6" CornerRadius="3" Margin="0,0,10,0"
                                            Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                    <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" Text="{Binding Title}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Clusters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardFlush}" Margin="0,0,0,12" Padding="14">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0"
                                                                Content="{loc:Loc Cards.StudyGroup}"
                                                                Command="{Binding DataContext.StudyClusterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Border Width="4" Height="18" CornerRadius="2" Margin="0,0,10,0"
                                                                Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                                        <TextBlock Style="{StaticResource H3}" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                                                    <Binding Path="Title" />
                                                                    <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Cards}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource DeckButton}"
                                                                        Command="{Binding DataContext.OpenDeckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Border Width="188" MinHeight="108" CornerRadius="12" Padding="14,12,12,12"
                                                                            Background="{Binding SoftHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                                                            BorderBrush="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}"
                                                                            BorderThickness="{Binding IsSelected, Converter={x:Static views:SelectedBorderConverter.Instance}}">
                                                                        <Grid>
                                                                            <Border Width="5" HorizontalAlignment="Left" Margin="-14,-12,0,-12"
                                                                                    CornerRadius="12,0,0,12"
                                                                                    Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                                                                            <StackPanel>
                                                                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                                                                    <TextBlock.Text>
                                                                                        <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                                                                            <Binding Path="Title" />
                                                                                            <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                                                        </MultiBinding>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                                                           Visibility="{Binding Total, Converter={x:Static views:PositiveToVisConverter.Instance}}">
                                                                                    <TextBlock.Text>
                                                                                        <MultiBinding Converter="{x:Static loc:LocFormatConverter.Instance}" ConverterParameter="Cards.DueOfTotal">
                                                                                            <Binding Path="Due" />
                                                                                            <Binding Path="Total" />
                                                                                            <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                                                                                        </MultiBinding>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{loc:Loc Cards.NoCards}"
                                                                                           Visibility="{Binding Total, Converter={x:Static views:EmptyCountToVisConverter.Instance}}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{loc:Loc Cards.Back}"
                        Command="{Binding CloseSessionCommand}"
                        Visibility="{Binding Studying, Converter={x:Static views:BoolVisConverter.Instance}}" />
                <TextBlock Style="{StaticResource H3}" VerticalAlignment="Center" Text="{Binding SessionTitle}" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{Binding Progress}" />

            <Border Style="{StaticResource CardFlush}" x:Name="CardFace" MouseLeftButtonUp="OnCardFlip"
                    RenderTransformOrigin="0.5,0.5"
                    Visibility="{Binding Studying, Converter={x:Static views:BoolVisConverter.Instance}}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" />
                </Border.RenderTransform>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="6" CornerRadius="12,12,0,0"
                            Background="{Binding AccentHex, Converter={x:Static views:HexToBrushConverter.Instance}}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{loc:Loc Cards.Keys}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding Current, Converter={x:Static views:NullToVisConverter.Instance}}">
                        <Button Content="{loc:Loc Cards.Again}" Command="{Binding RateCommand}" CommandParameter="NochEinmal" />
                        <Button Content="{loc:Loc Cards.Hard}" Command="{Binding RateCommand}" CommandParameter="Schwer" />
                        <Button Content="{loc:Loc Cards.Good}" Command="{Binding RateCommand}" CommandParameter="Gut" />
                        <Button Content="{loc:Loc Cards.Easy}" Command="{Binding RateCommand}" CommandParameter="Einfach" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                Visibility="{Binding Current, Converter={x:Static views:NullToVisConverter.Instance}}">
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Cards.Fav}" Command="{Binding FavoriteCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Cards.Note}" Command="{Binding SaveNoteCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Cards.Flip}" Click="OnFlipClick" />
                    </StackPanel>
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding Notes}" AcceptsReturn="True" Height="64"
                             Visibility="{Binding Current, Converter={x:Static views:NullToVisConverter.Instance}}" />
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="18" Margin="4,12,4,0"
                               Visibility="{Binding Current, Converter={x:Static views:NullToVisConverter.Instance}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                <Binding Path="Current.Front" />
                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Margin="4,16,4,8"
                               Visibility="{Binding ShowBack, Converter={x:Static views:BoolVisConverter.Instance}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static loc:LocContentConverter.Instance}">
                                <Binding Path="Current.Back" />
                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Margin="4,0,4,8" Style="{StaticResource Muted}"
                               Visibility="{Binding ShowBack, Converter={x:Static views:BoolVisConverter.Instance}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static loc:LocFormatConverter.Instance}" ConverterParameter="Cards.NextDue">
                                <Binding Path="Current.IntervalDays" />
                                <Binding Path="Language" Source="{x:Static loc:Loc.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Margin="4,0,4,8" FontStyle="Italic" Text="{Binding Current.Formula}" />
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Muted}"
                               Text="{Binding Empty}"
                               Visibility="{Binding Current, Converter={x:Static views:InverseNullToVisConverter.Instance}}" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardFlush}"
                    Visibility="{Binding Studying, Converter={x:Static views:InverseBoolToVisConverter.Instance}}">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Muted}"
                           Text="{Binding Empty}" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
