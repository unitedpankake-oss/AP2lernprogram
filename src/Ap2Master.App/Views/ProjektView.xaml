<UserControl x:Class="Ap2Master.App.Views.ProjektView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Ap2Master.App.Localization">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Margin="0,0,0,12" Text="{loc:Loc Proj.Calc}" />
        <Border DockPanel.Dock="Top" Style="{StaticResource CardFlush}" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc Proj.Calc}" Command="{Binding CalculateCommand}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{loc:Loc Proj.Format}" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="6" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardFlush}">
                <TextBox Text="{Binding Input}" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" />
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            <Border Grid.Column="2" Style="{StaticResource CardFlush}">
                <TextBox Text="{Binding Result}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
